function void BMA_print_status (const string message[null],
                                const bool done[0], const scalar spaces[1])
    /*
       Function prints current execution status and flushes screen.
    */
    string SPACE = ""
    if done == 1
        loop i=1..spaces --quiet
            SPACE += sprintf("%s", " ")
        endloop
        printf "%sdone!", SPACE
    else
        printf "\n%s: ", message
    endif
    flush
end function
