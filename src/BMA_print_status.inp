function void BMA_print_status (const string message[null], const bool done[0],
                                const scalar pspaces[0], const scalar spacesp[0])
    /*
       Function prints current execution status and flushes screen.
       message 	- text to be printed
       done		- if this is end of stage
       pspaces	- number of prior paces
       spacesp	- number of post spaces
    */
    string pSPACE = ""
    string SPACEp = ""
    if pspaces
        loop i=1..pspaces --quiet
            pSPACE += sprintf("%s", " ")
        endloop
    endif
    if spacesp
        loop i=1..spacesp --quiet
            SPACEp += sprintf("%s", " ")
        endloop
    endif

    if done
        printf "%sdone!", pSPACE
    else
        printf "\n%s%s:%s", pSPACE, message, SPACEp
    endif
    flush
end function
