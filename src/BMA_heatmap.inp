   but WITHOUT ANY WARRANTY; without even the implied warranty of
   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
   GNU General Public License for more details.

   You should have received a copy of the GNU General Public License
   along with this program. If not, see <http://www.gnu.org/licenses/>.
*/
function void BMA_heatmap (bundle M, string MODE, const string basename[null])
/*
   M		- BMA result bundle,
   MODE		- string indicating image mode {"inclusions", "jointness"}
   basename	- basename for gnuplot files
    */
    scalar nrows, ncols, tmp, height, width, minval, maxval
    string grid, title, xlabel, ylabel, xtics, ytics, colorbox, palette, rotate, output
    matrix m

    # We set general image options
    if MODE == "inclusions"
        title = sprintf("Variables Inclusions Based on Best %d Models", M.l_rank)
        xlabel = "Model number"
        ylabel = "Variable"
        colorbox = "unset colorbox"
        height = xmax(int(M.k/41*768), 480)
        width = xmin(xmax(int(M.l_rank/20*1024), 640), 1024)
        m = zeros(M.l_rank, M.k)
        loop i=1..M.l_rank --quiet
            m[i,] = M.mod_rank[i]
        endloop
        m = mreverse(m')
        palette = "0 'white', 1 'red'"
        output = "-PIP.plt"
    else
        title = sprintf("Jointness Based on %s", M.jointess_measure_names[M.do_joint])
        xlabel = "Variable"
        ylabel = xlabel
        height = xmin(xmax(int(M.k/41*1024), 640), 900)
        width = xmin(xmax(int(M.k/41*1024), 900), 1024)
        m = BMA_jointness_measure(&M)
        m[diag] = 0
        minval = minc(minr(m))
        maxval = maxc(maxr(m))
        m[diag] = NA
        m = mreverse(m)
        if minval == 0
            palette = sprintf("0 'white', %s 'red'", strsub(sprintf("%f", maxval), ",", "."))
        else
            palette = sprintf("%s 'blue', 0 'white', %s 'red'", strsub(sprintf("%f", minval), ",", "."), strsub(sprintf("%f", maxval), ",", "."))
        endif
        rotate = "set xtics rotate by 45 right"
        output = "-Jointness.plt"
    endif
    nrows = rows(m)
    ncols = cols(m)

    # We set tics
    ytics = "("
    loop i=1..M.k --quiet
        ytics += sprintf("\"%s\" %d", M.all_names_sp_new[i], M.k-i)
        if i == M.k
            ytics += sprintf(")")
        else
            ytics += sprintf(", ")
        endif
    endloop
    xtics = "("
    if MODE == "inclusions"
        loop i=1..M.l_rank --quiet
            xtics += sprintf("\"%.d\" %d", i, i-1)
            if i == M.l_rank
                xtics += sprintf(")")
            else
                xtics += sprintf(", ")
            endif
        endloop
    else
        loop i=1..M.k --quiet
            xtics += sprintf("\"%s\" %d", M.all_names_sp_new[i], i-1)
            if i == M.k
                xtics += sprintf(")")
            else
                xtics += sprintf(", ")
            endif
        endloop
    endif

    # We need to cast given matrix to its string representation
    loop i=1..nrows --quiet
        loop j=1..ncols --quiet
            if MODE == "inclusions"
                grid += sprintf("%d", m[i,j])
            else
                grid += strsub(sprintf("%.4f", m[i,j]), ",", ".")
            endif
            if j == ncols
                if i != nrows
                    grid += sprintf("\n")
                endif
            else
                grid += sprintf("\t")
            endif
        endloop
    endloop

    # We check if we display or save plot
    if $sysinfo.gui_mode
        output = "display"
    else
        output = sprintf("%s%s", basename, output)
    endif

    # We plot heatmap
    plot
        printf "set term pngcairo font \"Vera,9\" size %d,%d noenhanced", width, height
        literal set encoding utf8
        literal set decimalsign '.'
        literal set nokey
        literal set datafile missing ""
        #literal set datafile separator "\t"
        literal set x2tics 1 format '' scale 0,0.001
        literal set y2tics 1 format '' scale 0,0.001
        literal set mx2tics 2
        literal set my2tics 2
        printf "set palette defined (%s)", palette
        printf "set title \"%s\"", title
        printf "set xlabel \"%s\"", xlabel
        printf "set ylabel \"%s\"", ylabel
        printf "set xtics %s", xtics
        printf "set ytics %s", ytics
        printf "%s", colorbox
        printf "%s", rotate
        literal set autoscale fix
        literal set link x
        literal set link y
        literal set grid front mx2tics my2tics lw 2 lt -1 lc rgb 'white'
        printf "$map << EOD"
        printf "%s", grid
        printf "EOD"
        literal plot $map matrix with image
    end plot --output=@output
end function
