   You should have received a copy of the GNU General Public License
   along with this program. If not, see <http://www.gnu.org/licenses/>.
*/
function void BMA_Print (bundle *M)
/*
   Function prints BMA results
    */
    # We have to set sample
    if M.h_predict > 0
        smpl 1 M.last_obs
    endif

    # We re-create Y process
    string Y_name = M.Y_name
    series @Y_name = M.Y

    # Additional information in summary
    model_space = 2^M.k
    printf "\n"
    if M.verbosity == 2
        print "----------------------------------"
        printf "Model prior: %s\n", M.prior_name
        printf "Prior average model size: %f\n", M.av_model_size
        printf "Significance level for the initial model: %f\n", M.alpha
        printf "g-prior: %s\n", M.gtype
        printf "Total number of iterations: %d\n", M.Nrep
        printf "Number of burn-in draws: %d\n", M.Nburn
        if model_space < 2^31
            printf "Total number of possible models: %d\n", model_space
        else
            printf "Total number of possible models: %g\n", model_space
        endif
        printf "Number of models visited: %d\n", M.post_n_models
        printf "Number of models accepted: %d\n", M.post_n_models_accepted
        if exists(M.Norig) == 1
            printf "Original number of observations (with missing): %d\n", M.Norig
        endif
        print "----------------------------------"
        printf "\n"
        print "The initial model:"
        list start_model = M.StartModel
        ols @Y_name const start_model --simple
    endif

    # Standard information (PIPs, Means and so on)
    print "----------------------------------"
    printf "\n"
    printf "Prior:\n"
    printf "\taverage model size: %f\n", M.av_model_size
    printf "\tstandard deviation: %f\n", M.mod_size_sd_prior
    printf "Posterior:\n"
    printf "\taverage model size: %f\n", M.mod_size_av
    printf "\tstandard deviation: %f\n", M.mod_size_sd
    printf "\n"
    print "----------------------------------"
    printf "\n"
    print "Posterior moments (unconditional and conditional on inclusion):"
    if $version < 20170
        printf "%15f", M.Post_Results
    else
        printf "%15f", mreverse(msortby(M.Post_Results, 1))
    endif
    printf "\n"
    print "----------------------------------"
    printf "\n"
    print "Posterior probability of models:"
    loop i=1..rows(M.models_probs_percents) --quiet
        if i <= 4
            printf "Best %d\t models account for %.4f of mass\n", M.models_probs_percents[i,1], M.models_probs_percents[i,2]
        elif i == rows(M.models_probs_percents)
            printf "Best %d models account for %.4f of mass\n", M.models_probs_percents[i,1], M.models_probs_percents[i,2]
        else
            printf "Best %d models account for %.4f of mass\n", M.models_probs_percents[i,1], M.models_probs_percents[i,2]
        endif
    endloop
    printf "\nBest models ranking:\n"
    loop i=1..M.l_rank --quiet
        printf "Model %d:\t%f\n", i, M.Numerical_Likelihood[i]
    endloop
    printf "Total probability of the models in ranking (numerical): %f\n", sumc(M.Numerical_Likelihood)
    printf "\n"
    printf "Correlation coefficient between the analytical\n"
    printf "and numerical probabilities of the above models: %f\n", BMA_correlation_coeff(&M)

    # Forecasts
    if M.h_predict > 0
        printf "\n"
        print "----------------------------------"
        printf "\n"
        print "Predictive results:"
        printf "%15f", M.prediction
        printf "\n"
    endif

    # Jointess analysis
    if M.do_joint && nelem(M.jointness_m)
        matrix jointess_measure = BMA_jointness_measure(&M)
        string jointess_measure_name = M.jointess_measure_names[M.do_joint]
        print "----------------------------------"
        printf "\n"
        print "Posterior joint probability of variables:"
        printf "%15f", M.jointness_m
        printf "\n"
        printf "Jointness statistics (%s):\n", jointess_measure_name
        printf "%15f", jointess_measure
        scalar strong_sub = 0
        scalar significant_sub = 0
        scalar strong_com = 0
        scalar significant_com = 0
        matrix pairs = zeros(round(0.5*M.k^2), 3)
        scalar pair = 0
        loop i=1..M.k --quiet
            loop j=i+1..M.k --quiet
                if abs(jointess_measure[i,j]) > 1
                    pair += 1
                    pairs[pair,1] = jointess_measure[i,j]
                    pairs[pair,2] = i
                    pairs[pair,3] = j
                    if jointess_measure[i,j] < 0
                        if jointess_measure[i,j] < -2
                            strong_sub += 1
                        else
                            significant_sub += 1
                        endif
                    else
                        if jointess_measure[i,j] > 2
                            strong_com += 1
                        else
                            significant_com += 1
                        endif
                    endif
                endif
            endloop
        endloop
        if pair > 0
            pairs = msortby(pairs[1:pair, ], 1)
            scalar shift = 0
            if strong_sub > 0
                BMA_jointness_pairs("Strong substitutes:", &strong_sub, M.var_numbers, &shift, &pairs, M.jointness_m)
            endif
            if significant_sub > 0
                BMA_jointness_pairs("Significant substitutes:", &significant_sub, M.var_numbers, &shift, &pairs, M.jointness_m)
            endif
            if significant_com > 0
                BMA_jointness_pairs("Significant complements:", &significant_com, M.var_numbers, &shift, &pairs, M.jointness_m)
            endif
            if strong_com > 0
                BMA_jointness_pairs("Strong complements:", &strong_com, M.var_numbers, &shift, &pairs, M.jointness_m)
            endif
        endif
    endif

    # Printing models in ranking
    if M.verbosity == 2
        matrix coeffmat
        strings Xnames # names of X-es
        printf "\n\nBest models estimates:"
        loop i=1..M.l_rank --quiet
            if M.mod_nume_prob[i]
                Xnames = null
                printf "\n"
                print "----------------------------------"
                printf "\nModel: %d, posterior probability: %f", i, M.Numerical_Likelihood[i]
                if sum(M.mod_rank[i]) == 0
                    #printf "\n\n  %s\n", "None of the variables were significant."
                    #printf "  %s\n", "Model includes only the intercept term which is simply the average of the dependent variable."
                    Xnames = defarray("const")
                    coeffmat = M.mod_rank_estimates[i]
                else                    
                    Xnames = defarray("const") + M.all_names_sp_new[M.mod_rank_estimates[i][2:,3]]
                    coeffmat = M.mod_rank_estimates[i][,1:2]
                    # Very crude workaround for examples when Xnames has unprintable elements
                    if nelem(Xnames) != rows(coeffmat)
                        Xnames = null
                        Xnames = defarray("const") + M.all_names_sp_new[M.mod_rank_estimates[i][2:,3]]
                    endif                    
                endif
                modprint coeffmat Xnames
            endif
        endloop
    endif
    print "----------------------------------"
    printf "\n\n"
end function
