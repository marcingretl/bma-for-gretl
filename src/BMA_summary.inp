function void BMA_summary (bundle *M)
/*
   We summarise some BMA results and deleting redundand items from the returned bundle
    */
    # Normalisation of numerical probabilities of models in ranking
    M.Numerical_Likelihood = M.mod_nume_prob ./ (M.Nrep - M.Nburn)
    M.Post_Results = transp(M.var_prob ./ (M.Nrep - M.Nburn))
    M.bhat_avg = M.bhat_avg ./ (M.Nrep - M.Nburn)
    M.bvar_avg = M.bvar_avg ./ (M.Nrep - M.Nburn)
    # We construct Post_Results matrix
    matrix bvar = sqrt(M.bvar_avg - M.bhat_avg.^2)
    matrix tmp = M.bhat_avg' ~ bvar'
    M.Post_Results = M.Post_Results ~ tmp
    tmp = M.Post_Results[,2] ./ M.Post_Results[,1]
    M.Post_Results = M.Post_Results ~ tmp
    tmp = sqrt((M.Post_Results[,3] .* M.Post_Results[,3] .+ M.Post_Results[,2] .* M.Post_Results[,2]) ./ M.Post_Results[,1] .- M.Post_Results[,4] .* M.Post_Results[,4])
    M.Post_Results = M.Post_Results ~ tmp
    string title = "PIP Mean Std.Dev. Cond.Mean Cond.Std.Dev"
    cnameset(M.Post_Results, title)
    rnameset(M.Post_Results, M.all_names_sp)
    # Forecasts
    if M.h_predict > 0
        M.Yhat_avg = M.Yhat_avg ./ (M.Nrep - M.Nburn)
        M.Yhat_var_avg = M.Yhat_var_avg ./ (M.Nrep - M.Nburn)
        M.Yhat_var_avg = sqrt(M.Yhat_var_avg - M.Yhat_avg .^ 2)
        M.prediction = M.Y_mat_predict ~ M.Yhat_avg ~ M.Yhat_var_avg
        cnameset(M.prediction, M.Y_name ~ " Mean Std.Dev.")
        rnameset(M.prediction, M.predict_obs_names)
    endif
    # Jointess analysis
    if M.do_joint != 0
        # We must clean up principal diagonal
        M.jointness_m[diag] = 0
        M.jointness_m = M.jointness_m ./ (M.Nrep - M.Nburn)
        cnameset(M.jointness_m, M.all_names_sp)
        rnameset(M.jointness_m, M.all_names_sp)
    endif
    # Cleaning up the bundle
    delete M.show_progress
    delete M.var_numbers2
    delete M.big_mat
    delete M.ZtZinv_new
    delete M.k_new
    delete M.lprob_new
    delete M.X_new_num
    delete M.X_new
    delete M.ZtZinv_old
    delete M.k_old
    delete M.lprob_old
    delete M.X_old_num
    delete M.dj_new
    delete M.dj_old
    delete M.X_new_predict
    delete M.X_old_predict
    delete M.y_dem_sq
    delete M.y_mean
    delete M.yMy
    delete M.mod_struct
    delete M.mod_struct_new
    delete M.var_prob
    delete M.a
    delete M.b
    delete M.c
    delete M.bhat
    delete M.bvar
    delete M.XtY
    delete M.XtXinv
    delete M.bhat_avg
    delete M.bvar_avg
    if M.h_predict > 0
        delete M.big_mat_predict
        delete M.big_mat_dem_predict
        delete M.Y_mat_predict
        delete M.Yhat_avg
        delete M.Yhat_var_avg
        delete M.predict_obs_names
        delete M.Yhat
    endif
    delete M.acc_type
    delete M.g_type
    delete M.bhat_old
    delete M.bvar_old
    delete M.big_cross
    delete M.big_cross_const
    delete M.big_mat_dem
    delete M.big_mat_dem_const
    delete M.big_mat_const
    delete M.mod_rank_dec
    delete M.mod_struct_old
    delete M.scaling_f
    delete M.var_numbers_const
    delete M.X_list
    delete M.XtY_cross_const
    delete M.Y_mat
    delete M.all_names_sp
end function
