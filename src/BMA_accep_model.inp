function scalar BMA_accep_model (bundle *M)
/*
   Function computes "probability" of the new model and checks if it is bigger than some random value drawn form U(0,1).
    */
    if BMA_accept_prob(&M) > log(randgen1(u,0,1))
        # We accept new model
        BMA_model_switch("ACCEPT", &M)
        return 1
    else
        # We restore old model
        BMA_model_switch("RESTORE", &M)
        return 0
    endif
end function
