function bundle BMA_GUI (series Y "Dependent variable",
                         list X_list "List of indenpendent variables (X)",
                         int acc_type[1:2:1] "Model prior" {"Binomial", "Binomial-Beta"},
                         scalar av_model_size[0::1] "Prior average model size",
                         scalar alpha[0:1:0.6] "Significance level for the initial model",
                         int l_rank[2::4] "Number of the top ranked models",
                         int g_type[1:5:1] "g-prior type" {"Benchmark prior", "Unit Information Prior (g-UIP)", "Risk Inflation Criterion (g-RIC)", "Hannan and Quinn HQC", "Root of g-UIP"},
                         int do_joint[0:7:0] "Jointness analysis" {"None", "Ley-Steel Measure (LS2)", "Doppelhofer-Weeks Measure (DW2)", \
                         "Ley-Steel Measure (LS1)", "Doppelhofer-Weeks Measure (DW1)", "Strachan Measure", "Yule's Q Measure (YQ)", "Modified Yule's Q Measure (YQM)"},
                         int h_predict[0::0] "Number of out-of-sample forecasts",
                         int Nrep[1e+06] "Total number of replications",
                         int burn[0:99:10] "Percentage of burn-in draws",
                         int verbosity[1:2:1] "Verbosity",
                         bool show_progress[1] "Show overall progress")
    /*
    GUI-based function to carry out BMA analysis.
    Function is a wrapper to bundle-based BMA() interface.
    */
    bundle Options
    string Y_name = argname(Y)
    series @Y_name = Y
    scalar Options["acc_type"] = acc_type
    scalar Options["av_model_size"] = av_model_size
    scalar Options["alpha"] = alpha
    scalar Options["l_rank"] = l_rank
    scalar Options["g_type"] = g_type
    scalar Options["do_joint"] = do_joint
    scalar Options["h_predict"] = h_predict
    scalar Options["Nrep"] = Nrep
    scalar Options["burn"] = burn
    scalar Options["verbosity"] = verbosity
    scalar Options["show_progress"] = show_progress
    
    return BMA(@Y_name, X_list, Options)
end function
