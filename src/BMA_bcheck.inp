   GNU General Public License for more details.

   You should have received a copy of the GNU General Public License
   along with this program. If not, see <http://www.gnu.org/licenses/>.
*/
function string BMA_bcheck (const bundle UserOpts, scalar k, scalar *acc_type, scalar *av_model_size,
                            scalar *alpha, scalar *l_rank, scalar *g_type, scalar *do_joint,
                            scalar *h_predict, scalar *Nrep, scalar *burn, scalar *verbosity,
                            scalar *show_progress, scalar *do_plot)
    /*
       This function checks options bundle and returns error message in
       any problem found.
       Parameters:

       UserOpts - bundle with user-defined options for BMA
       k - number of independent variables
    */
    string err = ""
    scalar err2
    bundle Options
    scalar arg_val
    string arg_name
    strings Integers = defarray("model_prior", "Nrank", "g_type", "do_joint", "Npredict", "Nrep", "burn", "verbosity")
    strings Booleans = defarray("show_progress", "do_plot")
    strings Scalars = defarray("avg_model_size", "alpha")
    if $version >= 20221 && $sysinfo.gui_mode == 1
        do_plot = 1
    else
        do_plot = 0
    endif

    # We set the default Nrep conditional on k
    if k <= 10
        Nrep = 10000
    elif k <= 15
        Nrep = 20000
    elif k <= 19
        Nrep = 100000
    else
        Nrep = 1e+06
    endif

    # Template bundle with default values
    scalar Options["model_prior"] = 1
    scalar Options["avg_model_size"] = k/2
    scalar Options["alpha"] = 0.6
    scalar Options["Nrank"] = xmin(2^(k-1), 40)
    scalar Options["g_type"] = 1
    scalar Options["do_joint"] = 0
    scalar Options["Npredict"] = 0
    scalar Options["Nrep"] = Nrep
    scalar Options["burn"] = 10
    scalar Options["verbosity"] = 2
    scalar Options["show_progress"] = 1
    scalar Options["do_plot"] = do_plot

    # General checking, but still needs some manual work
    err2 = bcheck(&Options, UserOpts)
    if err2
        err = "Look at the PDF documentation for expected types of arguments."
    endif

    # We check integers
    loop i=1..nelem(Integers) --quiet
        arg_name = Integers[i]
        arg_val = Options[arg_name]
        if arg_val != int(arg_val)
            err += sprintf("Argument %s must be an integer", arg_name)
        endif
    endloop

    # We check booleans
    loop i=1..nelem(Booleans) --quiet
        arg_name = Booleans[i]
        arg_val = Options[arg_name]
        if arg_val != int(arg_val) || arg_val < 0 || arg_val > 1
            err += sprintf("Argument %s must be a bool", arg_name)
        endif
    endloop

    # We set arguments
    acc_type = Options["model_prior"]
    av_model_size = Options["avg_model_size"]
    alpha = Options["alpha"]
    l_rank = Options["Nrank"]
    g_type = Options["g_type"]
    do_joint = Options["do_joint"]
    h_predict = Options["Npredict"]
    Nrep = Options["Nrep"]
    burn = Options["burn"]
    verbosity = Options["verbosity"]
    show_progress = Options["show_progress"]
    do_plot = Options["do_plot"]

    # We check arguments for valid values
    if acc_type < 1 || acc_type > 2
        err += "Model prior takes the integer values in the range [1; 2]"
    elif alpha < 0 || alpha > 1
        err += "The significance level (alpha) takes the real values in the range [0; 1]"
    elif g_type < 0 || g_type > 5
        err += "Zellner's g-prior takes the integer values in the range [1; 5]"
    elif do_joint < 0 || do_joint > 7
        err += "Jointess type (do_joint) takes the integer values in the range [1; 7]"
    elif h_predict < 0
        err += "Number of out-of-sample forecasts (h_predict) takes the integer values"
    elif h_predict >= round($nobs/2)
        printf("Number of out-of-sample forecasts is more than 50%s of sample length.\n", "%")
    elif Nrep < 0
        err += "Total number of replications (Nrep) takes the integer values"
    elif burn < 0 || burn > 99
        err += "Percentage of burn-in draws (do_burn) takes the integer values in the range [0; 99]"
    elif verbosity < 1 || verbosity > 2
        err += "Verbosity takes the integer values in the range [1; 2]"
    endif

    return err
end function
