function bundle BMA (series Y "Dependent variable",
                     list X_list "List of indenpendent variables (X)",
      bundle Options[null])
    /*
       Bundle-based interface to carry out BMA analysis.
       Function returns bundle MODEL with (formatted) results.
    */

    # We need to force use of dot as decimal point
    set force_decpoint on

    bundle MODEL
    string Y_name = argname(Y)
    scalar Norig = NA
    series @Y_name = Y
    string err

    if !exists(Options)
        bundle Options
    endif

    # Bundle check and setting default values (if needed)
    err = BMA_bcheck(Options, &MODEL, nelem(X_list))
    if strlen(err) != 0
        funcerr "@err !!!"
        return MODEL
    endif
    Norig = $nobs

    # Handling missing values
    smpl Y X_list --no-missing --quiet
    if Norig != $nobs
        printf "\nThere are missing values in dataset!"
    else
        Norig = NA
    endif

    # Basic parsing and checking
    err = BMA_parse(&MODEL, Y, argname(Y), X_list)
    if strlen(err) != 0
        if MODEL["_gui"]
            MODEL["err"] = err
        else
            funcerr "@err !!!"
        endif
    else
        MODEL = BMA_setup(&MODEL, Norig)
        # Setting sample for forecasting
        if MODEL["Npredict"]
            smpl 1 MODEL["last_obs"]
        endif
        BMA_main(&MODEL)
        BMA_summary(&MODEL)
        if MODEL["verbosity"]
            BMA_Print(&MODEL)
            if MODEL["do_plot"]
                BMA_Plot(&MODEL)
            endif
        endif
    endif

    set warnings on
    return MODEL
end function
