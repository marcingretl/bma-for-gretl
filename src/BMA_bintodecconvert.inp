function scalar BMA_bintodecconvert (const matrix mod_struct, const scalar k)
/*
   Function treats current draw as a binary digit and converts it
   into decimal integer.
   #
   mod_struct - model structure (binary vector)
   k - lenght of the 'mod_struct' vector [possibly redundant]
    */
    return sum(mod_struct .* 2 .^ seq(k-1, 0))
end function
