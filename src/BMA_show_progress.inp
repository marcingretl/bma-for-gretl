function void BMA_show_progress (const scalar iter,
                                 scalar *percentage,
                                 const scalar progress,
                                 const scalar N)
    /*
       Function prints overall progress
    */
    printf "%d%%\r", ceil(100 * iter/N)
    percentage += progress
    flush
end function
