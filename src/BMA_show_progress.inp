function void BMA_show_progress (scalar *rep,
                                 scalar *percentage,
                                 scalar *progress,
                                 scalar Nrep)
    /*
    Function prints overall progress
    */
    if rep == percentage
        val = floor(100 * rep/Nrep)
        if $version >= 20221
            printf "%d%%\r", val
        else
            printf "%d%%", val
            if val < 100
                printf ".."
            endif            
        endif
        percentage += progress
        flush
    endif    
end function
