function matrix BMA_dectobitconvert (const scalar num,
                                     const scalar n)
    /*
    This code was written by Jack.
    Function converts decimal digit into binary digit.
    #
    num - decimal digit to be converted
    n - lenght of binary vector
    Returns: binary vector holding model structure
    */
    x = num
    ret = zeros(n, 1)
    i = 1
    loop while x>0 --quiet
        y = x % 2
        ret[i++] = 	y
        x -= y
        x /= 2
    endloop
    return transp(mreverse(ret))
end function
