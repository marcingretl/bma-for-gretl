set verbose off
open FLS_41t72.gdt
include BMA.gfn

# We set the seed in order to exact reproduction of results
set seed 1000000
set stopwatch

list Factors = { 2..42 }
flsres = BMA(GDP_growth, Factors, _(Nrep=3000000, burn=33, Nrank=20, do_joint=7))

printf "Total execution time: %.2f sec.\n", $stopwatch
