<?xml version="1.0" encoding="UTF-8"?>
<gretl-functions>
<gretl-function-package name="BMA" minver="2017b" lives-in-subdir="true">
<author email="marcin.blazejowski@wsb.torun.pl">Marcin Błażejowski, Jacek Kwiatkowski</author>
<version>2.2-svn</version>
<date>2022-02-08</date>
<description>Bayesian Model Averaging for the linear regression models with jointness measures</description>
<tags>C11 C21</tags>
<label>Bayesian Model Averaging</label>
<menu-attachment>MAINWIN/Model/LinearModels</menu-attachment>
<help>
pdfdoc:BMA.pdf
</help>
<gretl-function name="BMA_Print" type="void" pkg-role="bundle-print">
 <params count="1">
  <param name="M" type="bundleref"/>
 </params>
<code>/*
Function prints BMA results
*/
# We have to set sample
if M.h_predict &gt; 0
  smpl 1 M.last_obs
endif
# We re-create Y process
string Y_name = M.Y_name
series @Y_name = M.Y
# Additional information in summary
printf &quot;\n&quot;
if M.verbosity == 2
  print &quot;----------------------------------&quot;
  printf &quot;Prior: %s\n&quot;, M.prior_name
  printf &quot;Prior average model size: %f\n&quot;, M.av_model_size
  printf &quot;Significance level for the initial model: %f\n&quot;, M.alpha
  printf &quot;g-prior: %s\n&quot;, M.gtype
  printf &quot;Total number of iterations: %d\n&quot;, M.Nrep
  printf &quot;Number of burn-in draws: %d\n&quot;, M.Nburn
  if exists(M.Norig) == 1
    printf &quot;Original number of observations (with missing): %d\n&quot;, M.Norig
  endif
  printf &quot;\n&quot;
  print &quot;The initial model:&quot;
  list start_model = M.StartModel
  ols @Y_name const start_model --simple
endif
# Standard information (PIPs, Means and so on)
print &quot;----------------------------------&quot;
printf &quot;\n&quot;
printf &quot;Posterior average model size: %f\n&quot;, M.mod_size/(M.Nrep - M.Nburn)
printf &quot;\n&quot;
print &quot;Posterior moments (unconditional and conditional on inclusion):&quot;
if $version &lt; 20170
  printf &quot;%15f&quot;, M.Post_Results
else
  printf &quot;%15f&quot;, mreverse(msortby(M.Post_Results, 1))
endif
printf &quot;\n&quot;
print &quot;----------------------------------&quot;
printf &quot;\n&quot;
print &quot;Posterior probability of models:&quot;
loop for i=1..M.l_rank --quiet
  printf &quot;Model %d:\t%f\n&quot;, i, M.Numerical_Likelihood[i]
endloop
printf &quot;Total probability of the models in ranking (numerical): %f\n&quot;, sumc(M.Numerical_Likelihood)
printf &quot;\n&quot;
printf &quot;Correlation coefficient between the analytical\n&quot;
printf &quot;and numerical probabilities of the above models: %f\n&quot;, BMA_correlation_coeff(&amp;M)
# Forecasts
if M.h_predict &gt; 0
  printf &quot;\n&quot;
  print &quot;----------------------------------&quot;
  printf &quot;\n&quot;
  print &quot;Predictive results:&quot;
  printf &quot;%15f&quot;, M.prediction
  printf &quot;\n&quot;
endif
# Jointess analysis
if M.do_joint != 0
  matrix jointess_measure = BMA_jointness_measure(&amp;M)
  if M.do_joint == 1
    string jointess_measure_name = &quot;Ley-Steel Measure&quot;
  else
    string jointess_measure_name = &quot;Doppelhofer-Weeks Measure&quot;
  endif
  print &quot;----------------------------------&quot;
  printf &quot;\n&quot;
  print &quot;Posterior joint probability of variables:&quot;
  printf &quot;%15f&quot;, M.jointness_m
  printf &quot;\n&quot;
  printf &quot;Jointness statistics (%s):\n&quot;, jointess_measure_name
  printf &quot;%15f&quot;, jointess_measure
  scalar strong_sub = 0
  scalar significant_sub = 0
  scalar strong_com = 0
  scalar significant_com = 0
  matrix pairs = zeros(round(0.5*M.k^2), 3)
  scalar pair = 0
  loop for i=1..M.k --quiet
    loop for j=i+1..M.k --quiet
      if abs(jointess_measure[i,j]) &gt; 1
        pair += 1
        pairs[pair,1] = jointess_measure[i,j]
        pairs[pair,2] = i
        pairs[pair,3] = j
        if jointess_measure[i,j] &lt; 0
          if jointess_measure[i,j] &lt; -2
            strong_sub += 1
          else
            significant_sub += 1
          endif
        else
          if jointess_measure[i,j] &gt; 2
            strong_com += 1
          else
            significant_com += 1
          endif
        endif
      endif
    endloop
  endloop
  if pair &gt; 0
    pairs = msortby(pairs[1:pair, ], 1)
    scalar shift = 0
    if strong_sub &gt; 0
      BMA_jointness_pairs(&quot;Strong substitutes:&quot;, &amp;strong_sub, M.var_numbers, &amp;shift, &amp;pairs)
    endif
    if significant_sub &gt; 0
      BMA_jointness_pairs(&quot;Significant substitutes:&quot;, &amp;significant_sub, M.var_numbers, &amp;shift, &amp;pairs)
    endif
    if significant_com &gt; 0
      BMA_jointness_pairs(&quot;Significant complements:&quot;, &amp;significant_com, M.var_numbers, &amp;shift, &amp;pairs)
    endif
    if strong_com &gt; 0
      BMA_jointness_pairs(&quot;Strong complements:&quot;, &amp;strong_com, M.var_numbers, &amp;shift, &amp;pairs)
    endif
  endif
endif
# Printing models in ranking
if M.verbosity == 2
  # We copy the bundle
  bundle M_new = M
  matrix k_new_mat = sumr(M_new.mod_rank)
  loop for i=1..M_new.l_rank --quiet
    if M_new.mod_nume_prob[i] == 0
      break
    endif
    matrix M_new.X_new = {}
    matrix M_new.XtY = {}
    matrix M_new.XtXinv = {}
    matrix M_new.bhat = {}
    matrix M_new.bvar = {}
    scalar M_new.yMy = 0
    string Xnames = &quot;&quot;
    list X = const
    loop for j=1..M_new.k --quiet
      if M_new.mod_rank[i,j] == 1
        if rows(M_new.X_new) == 0
          M_new.X_new = M_new.big_mat_dem[,j+1]
        else
          M_new.X_new = M_new.X_new ~ M_new.big_mat_dem[,j+1]
        endif
        Xnames += &quot;,&quot; ~ varname(M_new.var_numbers[j+1])
      endif
    endloop
    # Bayesian OLS for models in ranking
    printf &quot;\n&quot;
    print &quot;----------------------------------&quot;
    printf &quot;\nModel: %d, posterior probability: %f&quot;, i, M_new.Numerical_Likelihood[i]
    M_new.k_new = k_new_mat[i]
    if M_new.k_new == 0
      printf &quot;\n\n  %s\n&quot;, &quot;None of the variables were significant.&quot;
      printf &quot;  %s\n&quot;, &quot;Model includes only the intercept term which is simply the average of the dependent variable.&quot;
    else
      BMA_matrix_precompute(&amp;M_new)
      BMA_ols(&amp;M_new)
      matrix coeffmat = M_new.bhat ~ sqrt(M_new.bvar)
      coeffmat = coeffmat[2:M_new.k_new+1,]
      modprint coeffmat Xnames
    endif
  endloop
endif
print &quot;----------------------------------&quot;
printf &quot;\n\n&quot;
</code>
</gretl-function>
<gretl-function name="BMA_GUI" type="bundle" pkg-role="gui-main">
 <params count="13">
  <param name="Y" type="series">
<description>Dependent variable</description>
  </param>
  <param name="X_list" type="list">
<description>List of indenpendent variables (X)</description>
  </param>
  <param name="acc_type" type="int" min="1" max="2" default="1">
<description>Model prior</description>
<labels count="2">
"Binomial" "Binomial-Beta" </labels>
  </param>
  <param name="av_model_size" type="scalar" min="0" default="1">
<description>Prior average model size</description>
  </param>
  <param name="alpha" type="scalar" min="0" max="1" default="0.6">
<description>Significance level for the initial model</description>
  </param>
  <param name="l_rank" type="int" min="2" default="4">
<description>Number of the top ranked models</description>
  </param>
  <param name="g_type" type="int" min="1" max="5" default="1">
<description>g-prior type</description>
<labels count="5">
"Benchmark prior" "Unit Information Prior (g-UIP)" "Risk Inflation Criterion (g-RIC)" "Hannan and Quinn HQC" "Root of g-UIP" </labels>
  </param>
  <param name="do_joint" type="int" min="0" max="2" default="0">
<description>Jointness analysis</description>
<labels count="3">
"None" "Ley-Steel Measure" "Doppelhofer-Weeks Measure" </labels>
  </param>
  <param name="h_predict" type="int" min="0" default="0">
<description>Number of out-of-sample forecasts</description>
  </param>
  <param name="Nrep" type="int" default="1e+06">
<description>Total number of replications</description>
  </param>
  <param name="burn" type="int" min="0" max="99" default="10">
<description>Percentage of burn-in draws</description>
  </param>
  <param name="verbosity" type="int" min="1" max="2" default="1">
<description>Verbosity</description>
  </param>
  <param name="show_progress" type="bool" default="1">
<description>Show overall progress</description>
  </param>
 </params>
<code>/*
Main public function to carry out BMA analysis
Function returns bundle MODEL with (formatted) results
*/
# Basic parsing and checking
bundle MODEL
Norig = $nobs
smpl Y X_list --no-missing --quiet
if Norig != $nobs
  printf &quot;\nThere are missing values in dataset!&quot;
else
  Norig = NA
endif
err = BMA_parse(&amp;MODEL, Y, argname(Y), X_list, &amp;av_model_size, &amp;l_rank)
if strlen(err) != 0
  funcerr &quot;@err !!!&quot;
else
  MODEL = BMA_setup(Y, MODEL.X_list, acc_type, av_model_size, alpha, l_rank, g_type, do_joint, h_predict, Nrep, burn, verbosity, argname(Y), show_progress, Norig)
  # Setting sample for forecasting
  if MODEL.h_predict &gt; 0
    smpl 1 MODEL.last_obs
  endif
  BMA_main(&amp;MODEL)
  BMA_summary(&amp;MODEL)
  BMA_Print(&amp;MODEL)
endif
set warnings on
return MODEL
</code>
</gretl-function>
<gretl-function name="BMA_OldStyle" type="bundle">
 <params count="11">
  <param name="big_list" type="list">
<description>List of all variables (Y must be the first one!!!)</description>
  </param>
  <param name="acc_type" type="int" min="1" max="2" default="1">
<description>Model prior</description>
<labels count="2">
"Binomial" "Binomial-Beta" </labels>
  </param>
  <param name="av_model_size" type="scalar" min="0" default="1">
<description>Prior average model size</description>
  </param>
  <param name="alpha" type="scalar" min="0" max="1" default="0.6">
<description>Significance level for the initial model</description>
  </param>
  <param name="l_rank" type="int" min="2" default="4">
<description>Number of the top ranked models</description>
  </param>
  <param name="g_type" type="int" min="1" max="5" default="1">
<description>g-prior type</description>
<labels count="5">
"Benchmark prior" "Unit Information Prior (g-UIP)" "Risk Inflation Criterion (g-RIC)" "Hannan and Quinn HQC" "Root of g-UIP" </labels>
  </param>
  <param name="do_joint" type="int" min="0" max="2" default="0">
<description>Jointness analysis</description>
<labels count="3">
"None" "Ley-Steel Measure" "Doppelhofer-Weeks Measure" </labels>
  </param>
  <param name="h_predict" type="int" min="0" default="0">
<description>Number of out-of-sample forecasts</description>
  </param>
  <param name="Nrep" type="int" default="1e+06">
<description>Total number of replications</description>
  </param>
  <param name="burn" type="int" min="0" max="99" default="10">
<description>Percentage of burn-in draws</description>
  </param>
  <param name="verbosity" type="int" min="1" max="2" default="1">
<description>Verbosity</description>
  </param>
 </params>
<code>/*
Function for backward compatibility
*/
bundle OldStyle
matrix big_list_m = big_list
if cols(big_list_m) &gt;= 2
  string Y_name = varname(big_list_m[1])
  series @Y_name = big_list[1]
  OldStyle = BMA_GUI(@Y_name, big_list-big_list[1], acc_type, av_model_size, alpha, l_rank, g_type, do_joint, h_predict, Nrep, burn, verbosity)
else
  funcerr &quot;BMA needs at least one intenpendent variable.&quot;
endif
return OldStyle
</code>
</gretl-function>
<gretl-function name="BMA" type="bundle">
 <params count="3">
  <param name="Y" type="series">
<description>Dependent variable</description>
  </param>
  <param name="X_list" type="list">
<description>List of indenpendent variables (X)</description>
  </param>
  <param name="Options" type="bundle" optional="true"/>
 </params>
<code>/*
Bundle-based call of BMA_GUI (wrapper).
Function returns bundle MODEL with (formatted) results.
*/
string Y_name = argname(Y)
series @Y_name = Y
scalar acc_type = exists(Options[&quot;acc_type&quot;]) ? Options[&quot;acc_type&quot;] : 1
scalar av_model_size = exists(Options[&quot;av_model_size&quot;]) ? Options[&quot;av_model_size&quot;] : 1
scalar alpha = exists(Options[&quot;alpha&quot;]) ? Options[&quot;alpha&quot;] : 0.6
scalar l_rank = exists(Options[&quot;l_rank&quot;]) ? Options[&quot;l_rank&quot;] : 4
scalar g_type = exists(Options[&quot;g_type&quot;]) ? Options[&quot;g_type&quot;] : 1
scalar do_joint = exists(Options[&quot;do_joint&quot;]) ? Options[&quot;do_joint&quot;] : 0
scalar h_predict = exists(Options[&quot;h_predict&quot;]) ? Options[&quot;h_predict&quot;] : 0
scalar Nrep = exists(Options[&quot;Nrep&quot;]) ? Options[&quot;Nrep&quot;] : 1e+06
scalar burn = exists(Options[&quot;burn&quot;]) ? Options[&quot;burn&quot;] : 10
scalar verbosity = exists(Options[&quot;verbosity&quot;]) ? Options[&quot;verbosity&quot;] : 1
scalar show_progress = exists(Options[&quot;show_progress&quot;]) ? Options[&quot;show_progress&quot;] : 1
return BMA_GUI(@Y_name, X_list, acc_type, av_model_size, alpha, l_rank, g_type, do_joint, h_predict, Nrep, burn, verbosity, show_progress)
</code>
</gretl-function>
<gretl-function name="BMA_model_switch" type="void" private="1">
 <params count="2">
  <param name="MODE" type="string"/>
  <param name="M" type="bundleref"/>
 </params>
<code>/*
This is general purpose model switching function which
save and restore old model or save new model
*/
if MODE == &quot;SAVE&quot;
  M.X_old_num = M.X_new_num
  if M.h_predict &gt; 0
    M.X_old_predict = M.X_new_predict
    M.ZtZinv_old = M.ZtZinv_new
    M.dj_old = M.dj_new
  endif
elif MODE == &quot;RESTORE&quot;
  M.X_new_num = M.X_old_num
  M.k_new = M.k_old
  if M.h_predict &gt; 0
    M.X_new_predict = M.X_old_predict
    M.ZtZinv_new = M.ZtZinv_old
    M.dj_new = M.dj_old
  endif
elif MODE == &quot;ACCEPT&quot;
  M.lprob_old = M.lprob_new
  M.k_old = M.k_new
  M.mod_struct = M.mod_struct_new
endif
</code>
</gretl-function>
<gretl-function name="BMA_parse" type="string" private="1">
 <params count="6">
  <param name="M" type="bundleref"/>
  <param name="Y" type="series"/>
  <param name="Y_name" type="string"/>
  <param name="X_list" type="list"/>
  <param name="av_model_size" type="scalarref" const="true"/>
  <param name="l_rank" type="scalarref" const="true"/>
 </params>
<code>/*
Function parses given list of variables end checks several conditions:
M				-	pointer to the bundle
Y				-	dependent variable
Y_name			-	name of dependent variable
X_list			-	list of given independent variables
*av_model_size	-	pointer to the scalar with prior average model size
*l_rank			-	pointer to the scalar with number of models in ranking
Returns: string err holding the first error found in given dataset
*/
# Local variables
scalar k = nelem(X_list)
string err = &quot;&quot;
# We check if given X_list does not include Y
if inlist(X_list, Y_name) != 0
  X_list -= X_list[inlist(X_list, Y_name)]
  k -= 1
  print &quot;Dependent viariable was removed from the X list.&quot;
endif
# We check if given X_list does not include const
if inlist(X_list, const) != 0
  X_list -= const
  k -= 1
  print &quot;Const was removed from the X list.&quot;
endif
# We check if given variables are not co-linear
# dropcoll() seems not to work good here
/*
if force_dof_lack == 0
  printf &quot;Jestem %d&quot;, force_dof_lack
  ols Y X_list const --quiet
  if $ncoeff &lt; k + 1
    X_list = $xlist - const
    print &quot;Some of the indenpendent variables were colinear and were dropped.&quot;
  endif
endif
*/
# We check if average model size is within 0 and K
if av_model_size &lt;= 0 || av_model_size &gt;= k
  err = &quot;Average model size should be greater then 0 and lower than K&quot;
  return err
endif
# We check if number of models in ranking is not greater than 2^K (model space)
if l_rank &gt; 2^k
  err = &quot;Number of the top ranked models cannot be greater than 2^K (space of parameters)&quot;
  return err
endif
matrix M.X_list = X_list
return err
</code>
</gretl-function>
<gretl-function name="BMA_initial_model" type="void" private="1">
 <params count="1">
  <param name="M" type="bundleref"/>
 </params>
<code>/*
Function creates list of variables for the initial model.
Local variables:
Y		- dependent variable
max_k	- number of given indenpendent variables
X_list2	- M.X_list in a form of list (not matrix)
*/
# Starting values of the local variables
series Y = M.Y
list X_list2 = M.X_list
list last = {}
scalar max_k = cols(M.var_numbers2)
#M.var_numbers2 = transp(msortby(transp(M.var_numbers2), 2))
if M.alpha == 0 # Empty model (const only)
  M.k_new = 0
elif M.alpha == 1	# Trully random model
  M.k_new = randint(0, max_k)
  if M.k_new &gt; 0
    if M.k_new == max_k # All variables in the starting model, nothing to draw
      last = X_list2
    else
      loop for i=1..M.k_new --quiet
        scalar accept = 0
        #set loop_maxiter 99999 # This should be set if we cannot construct random list
        loop while accept == 0 --quiet
          cand = transp(M.var_numbers2)[1, randint(1, max_k)]
          if inlist(last, cand) == 0
            last += cand
            accept = 1
          endif
        endloop
      endloop
      # We have to sort variables in created list
      matrix last_mat = zeros(2,M.k_new)
      last_mat[1,] = last
      loop for i=1..M.k_new --quiet
        loop for j=1..max_k --quiet
          if last_mat[1,i] == transp(M.var_numbers2)[1,j]
            last_mat[2,i] = transp(M.var_numbers2)[2,j]
            break
          endif
        endloop
      endloop
      last_mat = transp(msortby(transp(last_mat),2))
      last = last_mat[1,]
    endif
  endif
else
  # Model reduced at given M.alpha (classic OLS)
  ols Y const X_list2 --quiet
  omit --auto=M.alpha --silent
  last = $xlist
  last -= const
  M.k_new = $ncoeff-1
endif
M.k_old = nelem(last)
matrix M.StartModel = last
</code>
</gretl-function>
<gretl-function name="BMA_model_structure" type="void" private="1">
 <params count="1">
  <param name="M" type="bundleref"/>
 </params>
<code>/*
Function constructs structure vector of starting model
*/
# Starting values
matrix M.mod_struct_new = zeros(1,M.k)
# Setting 1 for variables in current draw
loop for i=1..cols(M.StartModel) --quiet
  loop for j=1..M.k --quiet
    if M.var_numbers2[1,j] == M.StartModel[i]
      M.mod_struct_new[M.var_numbers2[2,j]-1] = 1
      break
    endif
  endloop
  #M.mod_struct_new[M.StartModel[i]-1] = 1 # old (and buggy) version: to get rid of
endloop
# Filling in the mod_rank with starting structure
loop for i=1..M.l_rank --quiet
  M.mod_rank[i,] = M.mod_struct_new
endloop
</code>
</gretl-function>
<gretl-function name="BMA_correlation_coeff" type="scalar" private="1">
 <params count="1">
  <param name="M" type="bundleref"/>
 </params>
<code>/*
Function computes Pearson correlation coefficient between 2 ranking vectors:
Local variables:
tmp1, tmp2		- matrices with normalized analitycal and numerical probabilites
j				- scalar with number of the first row in rankings to ommit
Returns: correlation coefficient between analitical and numerical rankings
*/
# Starting values
matrix tmp1 = M.mod_rank_prob
matrix tmp2 = M.Numerical_Likelihood
scalar j = 0
# We check if there are zeros in numerical probablities...
# ...and if so we ommit such rows in both rankings.
loop i=1..M.l_rank --quiet
  if tmp2[i] == 0.0
    scalar j = i
    break
  endif
endloop
if j &gt;= 3
  tmp1 = tmp1[1:j-1,]
  tmp2 = tmp2[1:j-1,]
endif
# Now we have to normalize the given rankings
tmp1 -= maxc(tmp1)
tmp1 = exp(tmp1) ./ sumc(exp(tmp1))
tmp2 = tmp2 ./ sumc(tmp2)
return corr(tmp1,tmp2)
</code>
</gretl-function>
<gretl-function name="BMA_build_rank" type="void" private="1">
 <params count="1">
  <param name="M" type="bundleref"/>
 </params>
<code>/*
Function creates both analitycal and numerical model rankings.
Local variable:
nr - position (row) in rankings to be replaced
*/
# Initial value
scalar nr = 0
# We look for the lowest probability and replace it by probability of the current model (if bigger)
if M.lprob_old &gt; minc(M.mod_rank_prob) || maxc(M.mod_rank_prob) == 0
  loop for j=1..M.l_rank --quiet
    if M.lprob_old == M.mod_rank_prob[j] &amp;&amp; sumc(M.mod_rank[j,]) == sumc(M.mod_struct)
      if M.mod_rank[j,] == M.mod_struct
        break
      endif
    elif M.mod_rank_prob[j] == 0
      nr = j
      break
    elif M.lprob_old &gt; M.mod_rank_prob[j]
      nr = j
      break
    endif
  endloop
endif
# Now we replace analytical probability and model structure by new one (taken from current draw)
if nr &gt; 0
  if nr &lt; M.l_rank
    M.mod_rank_prob[nr+1:M.l_rank,] = M.mod_rank_prob[nr:M.l_rank-1,] # analytical
    M.mod_nume_prob[nr+1:M.l_rank,] = M.mod_nume_prob[nr:M.l_rank-1,] # numerical
    M.mod_rank[nr+1:M.l_rank,] = M.mod_rank[nr:M.l_rank-1,] # models in ranking (structure)
  endif
  M.mod_rank_prob[nr] = M.lprob_old
  M.mod_nume_prob[nr] = 0
  M.mod_rank[nr,] = M.mod_struct
endif
# Now we compute numerical probs
loop for j=1..M.l_rank --quiet
  if M.mod_rank[j,] == M.mod_struct
    M.mod_nume_prob[j] += 1
    break
  endif
endloop
</code>
</gretl-function>
<gretl-function name="BMA_gprior" type="scalar" private="1">
 <params count="2">
  <param name="k" type="scalar"/>
  <param name="type" type="int"/>
 </params>
<code>/*
Function computes g-prior:
*k	 - pointer to scalar holding numer of indenpendent variables
type - type of g-prior to be computed
Returs: scalar gprior
*/
# Starting value
scalar gprior = 0
if type == 1 # Benchmark prior
  if $nobs &lt; k^2
    gprior = 1/k^2
  else
    gprior = 1/$nobs
  endif
elif type == 2 # Unit Information Prior (g-UIP)
  gprior = 1/$nobs
elif type == 3 # Risk Inflation Criterion (g-RIC)
  gprior = 1/k^2
elif type == 4 # Hannan and Quinn HQC
  gprior = 1/(log($nobs))^3
elif type == 5 # Root of g-UIP
  gprior = sqrt(1/$nobs)
endif
return gprior
</code>
</gretl-function>
<gretl-function name="BMA_accept_prob" type="scalar" private="1">
 <params count="1">
  <param name="M" type="bundleref"/>
 </params>
<code>/*
Function computes probability (P_y) of given model based on selected prior.
Local variables:
A, B - scalars for computing probability based on Binomial-beta
Returns: the scalar with probability of current draw
*/
if M.acc_type == 1 # Binomial
  return (M.k_new - M.k_old)*(M.a - M.b) + M.lprob_new - M.lprob_old
elif M.acc_type == 2 # Binomial-beta
  scalar A = 0
  scalar B = 0
  A = lngamma(M.k + 1) - lngamma(M.k_new + 1) - lngamma(M.k - M.k_new + 1)
  B = lngamma(M.a + M.k_new) + lngamma(M.k + M.b - M.k_new) - lngamma(M.a + M.b + M.k)
  return A + B + M.c
endif
</code>
</gretl-function>
<gretl-function name="BMA_jointness_matrix" type="void" private="1">
 <params count="1">
  <param name="M" type="bundleref"/>
 </params>
<code>/*
Function counts coexistence (jointness) of every pair of variables in the given draw.
This piece of code was written by Jack (instead of our version which was much much slower)
*/
M.jointness_m = upper(M.jointness_m .+ ((M.mod_struct .* M.mod_struct') .&gt; 0))
</code>
</gretl-function>
<gretl-function name="BMA_jointness_measure" type="matrix" private="1">
 <params count="1">
  <param name="M" type="bundleref"/>
 </params>
<code>/*
Function computes jointness measure based on given jointness matrix.
Local variables:
var_prob - vector with posterior probability of indenpendent variables
B, C, D	 - scalars for Doppelhofer-Weeks Measure computation
Returns: matrix with computed jointness measure
*/
matrix var_prob = M.Post_Results[,1]
matrix jointness_measure = zeros(rows(M.jointness_m), cols(M.jointness_m))
loop for i=1..M.k --quiet
  loop for j=i+1..M.k --quiet
    if M.do_joint == 1 # Ley-Steel Measure
      jointness_measure[i,j] = log(M.jointness_m[i,j]/(var_prob[i] + var_prob[j] - 2*M.jointness_m[i,j]))
    elif M.do_joint == 2 # Doppelhofer-Weeks Measure
      scalar D = var_prob[j] - M.jointness_m[i,j]
      scalar B = 1 - var_prob[i] - D
      scalar C = var_prob[i] - M.jointness_m[i,j]
      jointness_measure[i,j] = log((M.jointness_m[i,j]*B)/(C*D))
    endif
  endloop
endloop
cnameset(jointness_measure, M.all_names_sp)
rnameset(jointness_measure, M.all_names_sp)
return jointness_measure
</code>
</gretl-function>
<gretl-function name="BMA_matrix_precompute" type="void" private="1">
 <params count="1">
  <param name="M" type="bundleref"/>
 </params>
<code>/*
Function computes some linear algebra stuff for further computation.
*/
if M.k_new &gt; 0
  if M.h_predict &gt; 0
    M.ZtZinv_new = invpd(M.X_new'M.X_new)
  endif
  matrix M.X_new = ones($nobs,1) ~ M.X_new
endif
matrix M.XtY = M.X_new'M.Y_mat
M.XtXinv = invpd(M.X_new'M.X_new)
M.yMy = M.scaling_f[7] - qform(M.XtY',M.XtXinv)
</code>
</gretl-function>
<gretl-function name="BMA_ols" type="void" private="1">
 <params count="1">
  <param name="M" type="bundleref"/>
 </params>
<code>/*
Function computes Bayesian OLS (posterior beta vector end covariance matrix).
*/
matrix Vhat = M.XtXinv / (1 + M.scaling_f[1])
M.bhat = Vhat * M.XtY
M.dj_new = M.scaling_f[3] * M.yMy + M.scaling_f[4]
M.bvar = diag((M.dj_new / ($nobs - 2)) * Vhat)
</code>
</gretl-function>
<gretl-function name="BMA_jointness_pairs" type="void" private="1">
 <params count="5">
  <param name="MODE" type="string"/>
  <param name="n_pairs" type="scalarref" const="true"/>
  <param name="var_numbers" type="matrix" const="true"/>
  <param name="shift" type="scalarref"/>
  <param name="pairs" type="matrixref" const="true"/>
 </params>
<code>/*
Function for generating vector with pairs of hightly releated variables
and jointness statistics for these pairs:
MODE			- string with type of relation between variables
*n_pairs		- pointer to the scalar with number of pairs of related variables
*var_numbers	- pointer to the matrix holding numbers of variables
*shift			- pointer to the scalar holding total number of previous pairs (shift in the &quot;pairs&quot; vector)
*pairs			- pointer to the cevtor holding (ordered) pairs of hightly releated variables
*/
matrix pairs_related = pairs[shift + 1 : shift + n_pairs, ]
shift += n_pairs
string pair_names = &quot;&quot;
loop for i=1..n_pairs --quiet
  pair_names += &quot; &quot; ~ varname(var_numbers[1+pairs_related[i,2]]) ~ &quot;,&quot; ~ varname(var_numbers[1+pairs_related[i,3]])
endloop
matrix pairs_related = pairs_related[,1]
printf &quot;\n%s\n&quot;, MODE
if rows(pairs_related) == 1
  printf &quot;%s\t%f\n&quot;, pair_names, pairs_related
else
  rnameset(pairs_related, pair_names)
  printf &quot;%15f&quot;, pairs_related
endif
</code>
</gretl-function>
<gretl-function name="BMA_new_X_matrix" type="void" private="1">
 <params count="2">
  <param name="MODE" type="string"/>
  <param name="M" type="bundleref"/>
 </params>
<code>/*
Function creates matrix of explanatory variables (demeaned) for current draw.
MODE - mode in which function operates: START (for starting model) or NORMAL
*/
# If we have at least one variable we create new X matrix, otherwise it includes &quot;Ones&quot; only.
if M.k_new &gt; 0
  if MODE == &quot;START&quot; # Note: this hapens only ones: for the starting model!!!
    BMA_model_structure(&amp;M)
  endif
  M.X_new_num = selifc(M.var_numbers2[2,], M.mod_struct_new)
  M.X_new = selifc(M.big_mat_dem[,2:], M.mod_struct_new)
  if M.h_predict &gt; 0
    M.X_new_predict = selifc(M.big_mat_dem_predict[,2:], M.mod_struct_new)
  endif
else
  M.X_new_num = {}
  M.X_new = ones($nobs,1)
  if M.h_predict &gt; 0
    M.X_new_predict = {}
  endif
endif
</code>
</gretl-function>
<gretl-function name="BMA_forecast" type="void" private="1">
 <params count="1">
  <param name="M" type="bundleref"/>
 </params>
<code>/*
This function computes forecast of Y (average mean and average standard deviation):
*/
# Mean
M.Yhat = M.X_new_predict * M.bhat[2:M.k_new+1] + M.y_mean
M.Yhat_avg = M.Yhat_avg + M.Yhat
# Variance
M.precision = (($nobs - 1) / M.dj_new) * ((1 + 1/$nobs + M.scaling_f[3] * diag(qform(M.X_new_predict, M.ZtZinv_new))) .^ -1)
M.Yhat_var_avg = M.Yhat_var_avg + (($nobs - 1) / (M.precision * ($nobs - 3)) + M.Yhat .^ 2)
</code>
</gretl-function>
<gretl-function name="BMA_accep_model" type="void" private="1">
 <params count="1">
  <param name="M" type="bundleref"/>
 </params>
<code>/*
Function computes &quot;probability&quot; of the new model and checks if it is bigger than some random value drawn form U(0,1).
*/
if BMA_accept_prob(&amp;M) &gt; log(randgen1(u,0,1))
  # We accept new model
  BMA_model_switch(&quot;ACCEPT&quot;, &amp;M)
  BMA_ols(&amp;M)
else
  # We restore old model
  BMA_model_switch(&quot;RESTORE&quot;, &amp;M)
endif
</code>
</gretl-function>
<gretl-function name="BMA_lprob" type="void" private="1">
 <params count="1">
  <param name="M" type="bundleref"/>
 </params>
<code>/*
Function computes lprob for current draw
*/
M.lprob_new = M.scaling_f[5]*(M.k_new + 1) - M.scaling_f[6]*log(M.scaling_f[3]*M.yMy + M.scaling_f[4])
</code>
</gretl-function>
<gretl-function name="BMA_averaging" type="void" private="1">
 <params count="1">
  <param name="M" type="bundleref"/>
 </params>
<code>/*
Function &quot;averages&quot; posterior results (values must be normalised after MC3)
*/
# For PiPs and average model size
M.mod_size += M.k_new
M.var_prob += M.mod_struct
# For coeffs
if M.k_new &gt; 0
  matrix indexes = M.X_new_num - 1
  M.bhat_avg[indexes] += transp(M.bhat[2:,])
  M.bvar_avg[indexes] += transp(M.bvar[2:,] + M.bhat[2:,] .^ 2)
endif
</code>
</gretl-function>
<gretl-function name="BMA_summary" type="void" private="1">
 <params count="1">
  <param name="M" type="bundleref"/>
 </params>
<code>/*
We summarise some BMA results and deleting redundand items from the returned bundle
*/
# Normalisation of numerical probabilities of models in ranking
M.Numerical_Likelihood = M.mod_nume_prob ./ (M.Nrep - M.Nburn)
M.Post_Results = transp(M.var_prob ./ (M.Nrep - M.Nburn))
M.bhat_avg = M.bhat_avg ./ (M.Nrep - M.Nburn)
M.bvar_avg = M.bvar_avg ./ (M.Nrep - M.Nburn)
# We construct Post_Results matrix
matrix bvar = sqrt(M.bvar_avg - M.bhat_avg.^2)
matrix tmp = M.bhat_avg' ~ bvar'
M.Post_Results = M.Post_Results ~ tmp
tmp = M.Post_Results[,2] ./ M.Post_Results[,1]
M.Post_Results = M.Post_Results ~ tmp
tmp = sqrt((M.Post_Results[,3] .* M.Post_Results[,3] .+ M.Post_Results[,2] .* M.Post_Results[,2]) ./ M.Post_Results[,1] .- M.Post_Results[,4] .* M.Post_Results[,4])
M.Post_Results = M.Post_Results ~ tmp
string title = &quot;PIP Mean Std.Dev. Cond.Mean Cond.Std.Dev&quot;
cnameset(M.Post_Results, title)
rnameset(M.Post_Results, M.all_names_sp)
# Forecasts
if M.h_predict &gt; 0
  M.Yhat_avg = M.Yhat_avg ./ (M.Nrep - M.Nburn)
  M.Yhat_var_avg = M.Yhat_var_avg ./ (M.Nrep - M.Nburn)
  M.Yhat_var_avg = sqrt(M.Yhat_var_avg - M.Yhat_avg .^ 2)
  M.prediction = M.Y_mat_predict ~ M.Yhat_avg ~ M.Yhat_var_avg
  cnameset(M.prediction, M.Y_name ~ &quot; Mean Std.Dev.&quot;)
  rnameset(M.prediction, M.predict_obs_names)
endif
# Jointess analysis
if M.do_joint != 0
  # We must clean up principal diagonal
  M.jointness_m[diag] = 0
  M.jointness_m = M.jointness_m ./ (M.Nrep - M.Nburn)
  cnameset(M.jointness_m, M.all_names_sp)
  rnameset(M.jointness_m, M.all_names_sp)
endif
# Cleaning up the bundle
delete M.show_progress
delete M.var_numbers2
delete M.big_mat
delete M.ZtZinv_new
delete M.k_new
delete M.lprob_new
delete M.X_new_num
delete M.X_new
delete M.ZtZinv_old
delete M.k_old
delete M.lprob_old
delete M.X_old_num
delete M.dj_new
delete M.dj_old
delete M.X_new_predict
delete M.X_old_predict
delete M.y_dem_sq
delete M.y_mean
delete M.yMy
delete M.mod_struct
delete M.mod_struct_new
delete M.var_prob
delete M.a
delete M.b
delete M.c
delete M.bhat
delete M.bvar
delete M.XtY
delete M.XtXinv
delete M.bhat_avg
delete M.bvar_avg
if M.h_predict &gt; 0
  delete M.big_mat_predict
  delete M.big_mat_dem_predict
  delete M.Y_mat_predict
  delete M.precision
  delete M.Yhat_avg
  delete M.Yhat_var_avg
  delete M.predict_obs_names
endif
</code>
</gretl-function>
<gretl-function name="BMA_main" type="void" private="1">
 <params count="1">
  <param name="M" type="bundleref"/>
 </params>
<code>/*
This is main BMA function with complete MC3 simulation procedure
*/
# Local variables
scalar progress = floor(M.Nrep/10) # progress of MCMC
scalar percentage = progress # percentage of progress of MCMC
# Sample setting for prediction
if M.h_predict &gt; 0
  smpl 1 M.last_obs
endif
##################
# Part 1: Starting model
# We estimate starting model and construct starting mod_rank_struct and mod_rank
BMA_initial_model(&amp;M)
BMA_new_X_matrix(&quot;START&quot;, &amp;M)
BMA_matrix_precompute(&amp;M)
BMA_lprob(&amp;M)
BMA_ols(&amp;M)
M.lprob_old = M.lprob_new
M.mod_struct = M.mod_struct_new
##################
# Part 2: Markov Chain Monte Carlo
printf &quot;\nOverall progress: &quot;
flush
loop for rep=1..M.Nrep --quiet
  # Saving data for the old model
  BMA_model_switch(&quot;SAVE&quot;, &amp;M)
  # Now we draw the number of candidate variable
  scalar potential_var = randint(0, M.k)
  # Now we modify the list of variables (remove an existing variable or add a new variable)
  if potential_var &gt; 0
    M.mod_struct_new = M.mod_struct
    M.mod_struct_new[potential_var] = !M.mod_struct_new[potential_var]
    # We create the new matrix of indenpendent variables and run some precomputes based on it
    M.k_new = sum(M.mod_struct_new)
    BMA_new_X_matrix(&quot;NORMAL&quot;, &amp;M)
    BMA_matrix_precompute(&amp;M)
    BMA_lprob(&amp;M)
    # Now we decide if to accept the new model
    BMA_accep_model(&amp;M)
  endif
  # Essentials of MCMC: building of rankings, averaging the results and jointness stuff
  # Now we construct rankings
  if rep &gt; M.Nburn
    BMA_build_rank(&amp;M)
    # Now we compute average model size, PIPs and average values of all coefficients and variances
    BMA_averaging(&amp;M)
    # Out-of-sample forecasts
    if M.h_predict &gt; 0 &amp;&amp; M.k_new &gt; 0
      BMA_forecast(&amp;M)
    endif
    # Jointness analysis
    if M.do_joint != 0
      BMA_jointness_matrix(&amp;M)
    endif
  endif
  if M.show_progress == 1
    BMA_show_progress(&amp;rep, &amp;percentage, &amp;progress, M.Nrep)
  endif
endloop
</code>
</gretl-function>
<gretl-function name="BMA_setup" type="bundle" private="1">
 <params count="15">
  <param name="Y" type="series" const="true"/>
  <param name="X_list_m" type="matrix"/>
  <param name="acc_type" type="int" min="1" max="2" default="1"/>
  <param name="av_model_size" type="scalar" min="0" default="1"/>
  <param name="alpha" type="scalar" min="0" max="1" default="0.6"/>
  <param name="l_rank" type="int" min="2" default="4"/>
  <param name="g_type" type="int" min="1" max="5" default="1"/>
  <param name="do_joint" type="int" min="0" max="2" default="0"/>
  <param name="h_predict" type="int" min="0"/>
  <param name="Nrep" type="int" default="1e+06"/>
  <param name="burn" type="int" min="0" max="99" default="10"/>
  <param name="verbosity" type="int" min="1" max="2" default="1"/>
  <param name="Y_name" type="string"/>
  <param name="show_progress" type="bool" default="1"/>
  <param name="Norig" type="int"/>
 </params>
<code>/*
This function creates BUNDLE holding all BMA information
#
Local variables:
tmp_str - general purpose string
*/
bundle M
list X_list = X_list_m
list big_list = Y X_list
string tmp_str = &quot;&quot;
#
# Basic parsing and checking
# Global variables
series M.Y = Y
matrix M.X_list = X_list
scalar M.acc_type = acc_type
scalar M.av_model_size = av_model_size
scalar M.alpha = alpha
scalar M.l_rank = l_rank
scalar M.g_type = g_type
scalar M.do_joint = do_joint
scalar M.h_predict = h_predict
scalar M.Nrep = Nrep
scalar M.burn = burn
scalar M.verbosity = verbosity
scalar M.show_progress = show_progress
if ok(Norig)
  scalar M.Norig = Norig
endif
# Local variables
matrix M.StartModel = {} # list with variables selected in starting model
matrix M.X_list = X_list # X_list
scalar M.k = nelem(X_list) # total number of indenpendent variables
scalar M.Nburn = round(burn/100*Nrep) # number of burn-in draws
matrix M.var_numbers = big_list # vector containing numbers of all variables (including Y) in dataset (not in the procedure)
matrix M.var_numbers2 = transp(msortby(transp(M.var_numbers[2:1+M.k] | seq(2,1+M.k)), 2)) # vector containing the dataset numbers of all variables and their order in the 'big_list'
matrix M.big_mat = { big_list } # matrix M.of all variables (including Y)
matrix M.big_mat_dem = cdemean(M.big_mat) # matrix M.of all demeaned variables (including Y)
# In case of &quot;out-of-sample&quot; prediction
if h_predict &gt; 0
  scalar M.last_obs = $nobs-h_predict # number of &quot;out-of-sample&quot; forecasts
  matrix M.big_mat_predict = M.big_mat[M.last_obs+1:$nobs,] # &quot;out-of-sample&quot; matrix M.of all variables (including Y)
  matrix M.big_mat_dem_predict = M.big_mat_dem[M.last_obs+1:$nobs,] # &quot;out-of-sample&quot; matrix M.of all demeaned variables (including Y)
  matrix M.Y_mat_predict = M.big_mat_predict[,1] # &quot;out-of-sample&quot; matrix M.of the dependent variable
  matrix M.Yhat = zeros(h_predict,1) # vector of Y predictions in current draw
  matrix M.precision = zeros(h_predict,1) # prediction precision
  matrix M.Yhat_avg = zeros(h_predict,1) # vector of Y predictions - average
  matrix M.Yhat_var_avg = zeros(h_predict,1) # predicion variance
  matrix M.prediction = {} # matrix with prediction results
  loop for i=(M.last_obs + 1)..$nobs --quiet
    tmp_str += strsub(obslabel(i), &quot; &quot;, &quot;&quot;) ~ &quot; &quot;
  endloop
  string M.predict_obs_names = tmp_str # obs labels for forecasts
  smpl 1 M.last_obs # setting sample
  matrix M.big_mat = M.big_mat[1:M.last_obs,] # big_mat for limited sample
  matrix M.big_mat_dem = M.big_mat_dem[1:M.last_obs,] # big_mat_dem for limited sample
else
  matrix M.big_mat_dem_predict = {}
  matrix M.Yhat_avg = {}
  matrix M.Yhat_var_avg = {}
  matrix M.Y_mat_predict = {}
  string M.predict_obs_names = &quot;&quot;
endif
# New model
matrix M.ZtZinv_new = {} # inverse of Z'Z (X's without constant term)
scalar M.k_new = 0 # number of variables in the current (new) model
scalar M.lprob_new = 0 # scalar M.with natural logarithm of marginal density of the new model
matrix M.X_new_num = {} # vector containing numbers of variables in the new model
matrix M.X_new = {} # the X matrix M.for the current (new) model (demeaned)
# Old model
matrix M.ZtZinv_old = {} # old inverse of Z'Z (X's without constant term)
scalar M.k_old = 0 # number of variables in the previous (old) model
scalar M.lprob_old = 0 # scalar M.with natural logarithm of marginal density of the old model
matrix M.X_old_num = {} # vector containing numbers of variables in the old model
scalar M.dj_new = 0 # scalar M.needed for prediction precision computation
scalar M.dj_old = 0 # scalar M.needed for prediction precision computation
matrix M.X_new_predict = {} # &quot;out-of-sample&quot; the X matrix M.for the current (new) model (demeaned)
matrix M.X_old_predict = {} # &quot;out-of-sample&quot; the X matrix M.for the previous (old) model (demeaned)
matrix M.Y_mat = M.big_mat[,1] # matrix M.of the dependent variable
scalar M.y_dem_sq = M.big_mat_dem[,1]'M.big_mat_dem[,1] # sum of squares of the demeaned Y
scalar M.y_mean = meanc(M.Y_mat) # mean of the Y
scalar M.mod_size = 0 # size of models in MCMC (sum)
scalar M.yMy = 0 # scalar M.for P_y computation
matrix M.scaling_f = zeros(7,1) # vector containing the scaling factors
matrix M.mod_struct = zeros(1,M.k) # 0-1 vector containing the structure of the current model
matrix M.mod_struct_new = zeros(1,M.k) # 0-1 vector containing the structure of the current model
matrix M.mod_rank = -1 * ones(l_rank,M.k) # 0-1 matrix M.containing structure of models in ranking
matrix M.mod_rank_prob = zeros(l_rank,1) # probability of the models in ranking (analytical)
matrix M.mod_nume_prob = zeros(l_rank,1) # probability of the models in ranking (numerical)
matrix M.var_prob = zeros(1,M.k) # vector containing PIPs
string M.all_names_sp = strsub(varname(X_list), &quot;,&quot;, &quot; &quot;) # string with names of all independent variables
string M.Y_name = Y_name # string with name of denpendent variable
if do_joint != 0
  matrix M.jointness_m = zeros(M.k,M.k) # square matrix M.containing counts of coexistence (jointness) of every pair of indenpendent variables
else
  matrix M.jointness_m = {}
endif
if acc_type == 1 # options for the prior
  string M.prior_name = &quot;Binomial&quot;
  scalar M.a = log(av_model_size/M.k)
  scalar M.b = log(1 - av_model_size/M.k)
  scalar M.c = 0
else
  string M.prior_name = &quot;Binomial-Beta&quot;
  scalar M.a = 1
  scalar M.b = (M.k - av_model_size)/av_model_size
  scalar M.c = lngamma(M.a + M.b) - lngamma(M.a) - lngamma(M.b)
endif
matrix M.bhat = {} # column vector containing the estimated coefficients for the current model
matrix M.bvar = {} # column vector containing the variances of the coefficients for the current model
matrix M.XtY = {} # X'Y (part of OLS)
matrix M.XtXinv = {} # inverse of X'X (part of OLS)
matrix M.bhat_avg = zeros(1,M.k) # column vector containing average values of coefficients (over MCMC)
matrix M.bvar_avg = zeros(1,M.k) # column vector containing average values of variances of the coefficients (over MCMC)
matrix M.Numerical_Likelihood = {} # column vector containing numerical probabilities for models
matrix M.Post_Results = {} # matrix with all posterior results
# Setting scaling factors: g0, g1, g2, .5*log(g1), .5*(n-1), Y'Y
matrix M.scaling_f = zeros(7,1) # vector containing the scaling factors
# g0 (g-prior)
M.scaling_f[1] = BMA_gprior(M.k, g_type)
# g1 (g/(1+g))
M.scaling_f[2] = M.scaling_f[1] / (1 + M.scaling_f[1])
# g2 (1/(1+g))
M.scaling_f[3] = 1 / (1 + M.scaling_f[1])
# g1*y_sq
M.scaling_f[4] = M.y_dem_sq * M.scaling_f[2]
# .5*log(g1)
M.scaling_f[5] = .5 * log(M.scaling_f[2])
# .5*(n-1)
M.scaling_f[6] = .5 * ($nobs - 1)
# Y'Y (sum of squares of Y)
M.scaling_f[7] = M.Y_mat'M.Y_mat
if g_type == 1
  string M.gtype = &quot;Benchmark prior&quot;
elif g_type == 2
  string M.gtype = &quot;Unit Information Prior (g-UIP)&quot;
elif g_type == 3
  string M.gtype = &quot;Risk Inflation Criterion (g-RIC)&quot;
elif g_type == 4
  string M.gtype = &quot;Hannan and Quinn HQC&quot;
elif g_type == 5
  string M.gtype = &quot;Root of g-UIP&quot;
endif
if verbosity == 1
  set warnings off
endif
return M
</code>
</gretl-function>
<gretl-function name="BMA_show_progress" type="void" private="1">
 <params count="4">
  <param name="rep" type="scalarref"/>
  <param name="percentage" type="scalarref"/>
  <param name="progress" type="scalarref"/>
  <param name="Nrep" type="scalar"/>
 </params>
<code>/*
Function prints overall progress
*/
if rep == percentage
  printf &quot;%d%s..&quot;, floor(100 * rep/Nrep), &quot;%&quot;
  percentage += progress
endif
flush
</code>
</gretl-function>
<sample-script filename="examples/BMA_sample.inp">
# Usage:
open greene9_1.gdt
include BMA.gfn

# We set the seed in order to exact reproduction of results
set seed 1000000

list greene = capital labor nfirm

BMA_GUI(valadd, greene, 1, 1.5, 0.6, 4, 1, 0, 0, 10000, 10, 1, 1)

# The above example consists of three blocks.
# The first block is just opening of the so called greene9_1 dataset,
# which is bundled in every standard gretl installation.
# This dataset contains cross-sectional data on manufacturing
# of transportation equipment # presented as Table 9.1 in
# Greene, Econometric Analysis, 4e}.

# The second block is the definition of the greene list which
# contains three independend variables available in the greene9_1 dataset.

# The third block contains the definition for Bayesian model
# averaging analysis: binomial prior, prior average model size
# set to 1.5 (which means that we have uniform model prior),
# significance level for the initial model set to 0.6,
# 4 top ranked models, Benchmark g-prior, without jointness analysis,
# without out-of-sample predictions, 10000 replications with 10%
# burn-in draws, basic output (verbosity set to 1)
# and progress overall progress is printed.


# Suppose we want to run the same analysis but following
# Occam's razor philosophy. The simplest way is setting the prior
# average model size to 1. The code would be as follows:
#BMA_GUI(valadd, greene, 1, 1, 0.6, 4, 1, 0, 0, 10000, 10, 1, 1)

# Because in the Occam's razor philosophy we penalize large
# models assigning high probability for small ones, better distribution
# then binomial is binomial-beta (which is right skewed). In order to
# use binomial-beta distribution we have to set prior to 2.
# The code would be as follows:
# BMA_GUI(valadd, greene, 2, 1, 0.6, 4, 1, 0, 0, 10000, 10, 1, 1)

# Suppose we want to set g-prior to Risk Inflation Criterion (g-RIC),
# uniform model prior, do jointness analysis with Ley-Steel Measure,
# compute forecasts for 3 observations and print additional information
# in results (verbosity set to 2) and we don't want to see any progress.
# The code would be as follows:
#BMA_GUI(valadd, greene, 1, 1.5, 0.6, 4, 3, 1, 3, 10000, 10, 2, 0)

# Finally, if we want to save results of the above Bayesian model
# averaging analysis in the bundle results_b,
# the code should be as follows:
results_b = BMA_GUI(valadd, greene, 1, 1.5, 0.6, 4, 3, 1, 3, 10000, 10, 2, 0)

# Suppose we want to compute Doppelhofer-Weeks Measure instead of
# already computed Ley-Steel Measure. Since the type of jointness measure
# is controlled by 'do_joint' field in the result bundle, the only thing
# we have to do is to set the value of 'do_join' to 2 and print BMA
# results again. The code should be as follows:
results_b.do_joint = 2
BMA_Print(&amp;results_b)

# If we need backwards compatibility with BMA_package prior to version 2
# we can use the BMA_OldStyle function to run the old style script.
#list greene_old = valadd capital labor nfirm
#BMA_OldStyle(greene_old, 1, 1.5, 0.6, 4, 1, 1, 3, 10000, 10, 2)
</sample-script>
</gretl-function-package>
</gretl-functions>
